{
  "schema_version": 1,
  "purpose": "Synthetic extraction evaluation only; never consumption/session records. No nutrient values or model scores.",
  "output_contract": {
    "required_keys": [
      "schema_version",
      "kind",
      "action",
      "foods",
      "session",
      "clarifications",
      "correction"
    ],
    "kind": [
      "food",
      "session"
    ],
    "action": [
      "propose",
      "clarify",
      "no_entry"
    ],
    "food_required_keys": [
      "name",
      "quantity",
      "unit",
      "preparation"
    ],
    "unit": [
      "g",
      "count",
      null
    ],
    "preparation": [
      "cooked",
      "raw",
      null
    ],
    "session_required_keys": [
      "category",
      "duration_minutes",
      "rpe"
    ],
    "category": [
      "bjj",
      "weights",
      null
    ],
    "clarification_flags": [
      "missing_quantity",
      "cooked_state",
      "food_identity",
      "session_category",
      "session_duration",
      "correction_target"
    ],
    "unknown": "JSON null; never a fabricated zero",
    "additional_keys": false,
    "nutrient_keys_forbidden": true
  },
  "judging": {
    "comparison": "Exact parsed JSON equality after object-key ordering only; array order and all nulls/flags are significant.",
    "name_normalization": "No hidden synonyms accepted. Benchmark prompt specifies canonical names used in cases. Real-world synonym matching is separate nutrient lookup.",
    "writes_allowed": false,
    "iterations_per_case": 3,
    "gate": "Every case must pass in every repetition; this small gate is necessary, not sufficient for release."
  },
