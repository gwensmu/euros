# Example only. Copy to an ignored .env and customize; do not commit credentials.
# The server does not automatically load this file. Export values in your shell
# or use your process supervisor's environment configuration.
EUROS_DB_PATH=/absolute/path/to/private/euros.sqlite3
EUROS_API_TOKEN_FILE=/absolute/path/to/private/app-token
EUROS_MCP_TOKEN_FILE=/absolute/path/to/private/mcp-token
# Optional AI configuration; select model IDs available to your account.
OPENAI_API_KEY_FILE=/absolute/path/to/private/provider-key
EUROS_FOOD_MODEL=YOUR_FOOD_MODEL_ID
EUROS_REVIEW_MODEL=YOUR_REVIEW_MODEL_ID
